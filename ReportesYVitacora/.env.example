# JWT Configuration
JWT_SECRET=default_secret_key
JWT_REFRESH_SECRET=default_refresh_secret_key

# Internal Service Authentication
INTERNAL_SERVICE_KEY=una_llave_secreta_compartida

# Microservices URLs
ORDER_SERVICE_URL=http://order-service-app:4003/api
INVENTORY_SERVICE_URL=http://inventory-service-app:4001/api
USER_SERVICE_URL=http://user-service-app:4002/api
RESERVATION_SERVICE_URL=http://reservation-service-app:4004/api
EVENT_SERVICE_URL=http://event-service-app:4005/api

# Server Configuration
PORT=4006

# HTTP Configuration
HTTP_TIMEOUT=10000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Cron Schedule (02:00 AM daily: 0 2 * * *)
CRON_SCHEDULE=0 2 * * *

# Report Generation
REPORTS_DIR=reportes
